{
  "name": "espn-fantasy-tools",
  "compatibility_date": "2026-08-28",
  "main": "src/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Every request runs the Worker first. This is what makes the League
    // Password check unbypassable — without it the edge would serve files in
    // ./public directly, with no auth check ever running.
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATA",
      "bucket_name": "espn-fantasy-tools-data"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COORDINATOR", "class_name": "DatasetCoordinator" },
      { "name": "THROTTLE", "class_name": "LoginThrottle" },
      { "name": "SCORE_TIMELINE", "class_name": "ScoreTimelineDO" },
      { "name": "FORTUNE", "class_name": "FortuneTellerDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DatasetCoordinator"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["LoginThrottle"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ScoreTimelineDO"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["FortuneTellerDO"]
    }
  ],
  // The platform's only scheduled work. Every other dataset is fetched on
  // demand, which is right for a snapshot but wrong for a gap-free historical
  // record: a score progression chart cannot reconstruct the minute nobody was
  // watching. Declared here rather than in the dashboard so a fork registers it
  // automatically on its first Workers Builds deploy, with nothing to click.
  // The handler itself checks whether anything is genuinely live before doing
  // any work, so this is a near-instant no-op outside game windows.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // Workers Logs: invocation logs, errors and uncaught exceptions for this
  // Worker and its Durable Objects, under Observability in the dashboard.
  // Declared here rather than switched on in the dashboard because every
  // deploy resets the Worker's settings to this file. Kept at the end of the
  // file, away from the two lines a fork edits (name and the KV namespace id),
  // so the daily sync merges it into forks without a conflict.
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
